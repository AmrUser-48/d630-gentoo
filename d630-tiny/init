#!/bin/sh
# D630 Tiny: standalone initramfs userspace. No Gentoo root or SquashFS required.
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
HOME=/root
TERM=linux
PS1='d630-tiny# '
export PATH HOME TERM PS1
if [ -x /usr/bin/curl ]; then
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
    SSL_CERT_FILE=$CURL_CA_BUNDLE
    export CURL_CA_BUNDLE SSL_CERT_FILE
fi

mount -t devtmpfs -o mode=0755 devtmpfs /dev 2>/dev/null || :
mkdir -p /dev/pts /dev/shm /proc /sys /run /tmp /root
mount -t proc proc /proc 2>/dev/null || :
mount -t sysfs sysfs /sys 2>/dev/null || :
mount -t devpts devpts /dev/pts 2>/dev/null || :
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp 2>/dev/null || :
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run 2>/dev/null || :

# Initialize built-in ZRAM as swap. The logical device size is half of
# detected RAM; physical memory is allocated lazily as pages are compressed.
setup_zram() {
    if [ ! -b /dev/zram0 ] || [ ! -w /sys/block/zram0/disksize ]; then
        printf '[d630-tiny] Built-in ZRAM is unavailable; continuing without compressed swap.\n'
        return
    fi

    mem_kb=
    while read -r key value rest; do
        if [ "$key" = "MemTotal:" ]; then
            mem_kb=$value
            break
        fi
    done < /proc/meminfo

    case "$mem_kb" in
        ''|*[!0-9]*)
            printf '[d630-tiny] Could not determine RAM size; ZRAM not enabled.\n'
            return
            ;;
    esac

    zram_bytes=$((mem_kb * 4096 * 40 / 100))
    if ! printf '%s\n' "$zram_bytes" > /sys/block/zram0/disksize; then
        printf '[d630-tiny] Could not set ZRAM size; continuing without compressed swap.\n'
        return
    fi
    if ! mkswap /dev/zram0 >/dev/null 2>&1; then
        printf '[d630-tiny] mkswap failed for /dev/zram0; continuing without compressed swap.\n'
        return
    fi
    if ! swapon /dev/zram0; then
        printf '[d630-tiny] swapon failed for /dev/zram0; continuing without compressed swap.\n'
        return
    fi

    printf '[d630-tiny] ZRAM swap enabled: %s MiB.\n' "$((zram_bytes / 1048576))"
}

setup_zram
hostname d630-tiny 2>/dev/null || :
dmesg -n 4 2>/dev/null || :

if [ -c /dev/tty0 ] && [ -x /usr/bin/setfont ] &&
    [ -r /usr/share/consolefonts/ter-powerline-v16n.psf.gz ]; then
    /usr/bin/setfont -C /dev/tty0 /usr/share/consolefonts/ter-powerline-v16n.psf.gz ||
        echo "[d630-tiny] Warning: could not load the normal Terminus Powerline console font."
fi

printf '\n  D630 Tiny Linux\n\n'
printf '  Kernel: '
uname -r
printf '  RAM:    '
grep MemTotal /proc/meminfo 2>/dev/null
printf '\n'
printf '  This is a RAM-only shell. Changes disappear at reboot.\n'
if [ -f /etc/d630-tiny/setup-mode ]; then
    printf '  Setup shell: gmini (Bash) | File manager: lf\n'
    printf '  Network: wifi-connect | Downloads: curl -fL URL -o /tmp/file\n\n'
elif command -v wifi-connect >/dev/null 2>&1; then
    printf '  Wi-Fi setup: wifi-connect | Downloads: curl -fL URL -o /tmp/file\n\n'
else
    printf '  Try: uname -a, free, dmesg, mount, ls /lib/firmware\n'
    printf '  Wi-Fi and download tools are in the internet-enabled initramfs variant.\n\n'
fi

while :; do
    if [ -f /etc/d630-tiny/setup-mode ]; then
        chown -R 1000:1000 /home/gmini
        setsid cttyhack login -f gmini
    else
        setsid cttyhack /bin/sh -i
    fi
    printf '\n[d630-tiny] shell exited; restarting console shell...\n'
    sleep 1
done

# 20-d630-base.config
# Full modular D630 kernel overlay for a conventional installed Gentoo system.
# Merge over Gentoo's own sys-kernel/gentoo-kernel distribution config.
# Gentoo defaults remain enabled unless explicitly overridden below.
# Root-device controller and root filesystem support remain built in.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_MICROCODE=y
CONFIG_FW_LOADER=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Keep the ordinary installed-root path available before modules are loaded.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y

# Dell ACPI / Core 2 power management.
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_X86_ACPI_CPUFREQ=m
CONFIG_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m

# GM965 / GMA X3100 graphics.
CONFIG_AGP=y
CONFIG_AGP_INTEL=m
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Intel PRO/Wireless 3945ABG.
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_IWLEGACY=m
CONFIG_IWL3945=m

# USB peripherals, storage, and Android RNDIS tethering.
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_HID=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m

# Input, audio, Bluetooth transport, touchpad and joystick are optional modules.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=m
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_USB_HID=m
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_HDA=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_BLUETOOTH=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_INPUT_JOYSTICK=m
CONFIG_INPUT_JOYDEV=m
CONFIG_MOUSE_PS2=m
CONFIG_MOUSE_PS2_ALPS=m
CONFIG_MOUSE_PS2_SYNAPTICS=m
CONFIG_MOUSE_PS2_TRACKPOINT=m

# Filesystems useful on the installed system; only ext4 is required at root.
CONFIG_BTRFS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_EXFAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_FAT_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=m
CONFIG_OVERLAY_FS=m

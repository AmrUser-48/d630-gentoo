# 20-d630-base.config
# Dell Latitude D630 — Gentoo distribution-kernel config.d overlay.
#
# Baseline used for design:
#   Gentoo sys-kernel/gentoo-kernel-6.1.190
#   Fedora x86_64 config: kernel-x86_64-fedora.config.6.1.102-gentoo
#   Gentoo dist-kernel overlay: gentoo-kernel-config-g19/base.config
#
# This is ONE config.d fragment, not a standalone .config. Portage starts from
# its version-specific Gentoo distribution config, merges Gentoo's base config,
# then applies /etc/kernel/config.d/*.config in lexical order.
#
# Intended for a conventional installed Gentoo system on the physical D630.
# Hardware drivers are modules where practical; storage/root essentials remain
# built in. The Gentoo live-SquashFS and Tiny kernels use profiles 40 and 30.
#
# x86-64 has no CONFIG_MCORE2 processor-family setting. Keep the generic
# x86-64 instruction baseline; tune kernel compilation with KCFLAGS=-mtune=core2.

CONFIG_EXPERT=y

# Core 2 / legacy BIOS platform.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_NR_CPUS_RANGE_END=2
CONFIG_NR_CPUS_DEFAULT=2
CONFIG_NUMA=n
CONFIG_CPU_SUP_INTEL=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_MICROCODE=y
CONFIG_FW_LOADER=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_EFI=n
CONFIG_EFI_STUB=n
CONFIG_FB_EFI=n
CONFIG_FB_VESA=y

# Root storage: AHCI SATA SSD and ICH8M PIIX IDE/ATAPI.
# Keep the controller and ext4 root path built in; removable/rescue filesystems
# and optical media can load as modules.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=m
CONFIG_SCSI_CDROM=m
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_EXFAT_FS=m
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_FUSE_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=m
CONFIG_OVERLAY_FS=m
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y

# GM965 / GMA X3100 (Intel Gen4).
CONFIG_AGP=y
CONFIG_AGP_INTEL=m
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_VGA_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Do not build unrelated AMD/NVIDIA, server or virtual display drivers.
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_VMWGFX=n
CONFIG_DRM_VIRTIO_GPU=n
CONFIG_DRM_QXL=n
CONFIG_DRM_BOCHS=n
CONFIG_DRM_VBOXVIDEO=n
CONFIG_DRM_AST=n
CONFIG_DRM_GMA500=n
CONFIG_DRM_MGAG200=n

# Intel PRO/Wireless 3945ABG only; keep the legacy Intel stack.
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_IWLEGACY=m
CONFIG_IWL3945=m
CONFIG_IWLWIFI=n

# Other Wi-Fi vendor families are not present in this machine.
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_BRCM=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_MICROCHIP=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_REALTEK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WWAN=n
CONFIG_WIMAX=n

# ICH8 UHCI/EHCI, USB storage/HID, and Android USB RNDIS tethering.
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_OHCI_HCD=n
CONFIG_USB_XHCI_HCD=n
CONFIG_USB_STORAGE=m
CONFIG_USB_HID=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_EEM=n
CONFIG_USB_NET_QMI_WWAN=n
CONFIG_USB_NET_CDC_MBIM=n
CONFIG_USB_NET_CDC_SUBSET=n
CONFIG_USB_NET_AX8817X=n
CONFIG_USB_NET_AX88179_178A=n
CONFIG_USB_NET_RTL8152=n
CONFIG_USB_PRINTER=n
CONFIG_USB_MON=n
CONFIG_USB_SERIAL=n
CONFIG_USB_GADGET=n
CONFIG_USB_CONFIGFS=n

# AT keyboard, Alps DualPoint touchpad, TrackPoint, USB mouse and joystick.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=m
CONFIG_MOUSE_PS2=m
CONFIG_MOUSE_PS2_ALPS=m
CONFIG_MOUSE_PS2_SYNAPTICS=m
CONFIG_MOUSE_PS2_TRACKPOINT=m
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_INPUT_JOYSTICK=m
CONFIG_INPUT_JOYDEV=m
CONFIG_HIDRAW=y
CONFIG_INPUT_UINPUT=n

# IDT/SigmaTel HDA audio and Bluetooth core/USB transport.
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_HDA=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_BLUETOOTH=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m

# Dell laptop hotkeys/platform, ACPI battery/thermal and sensor support.
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_VIDEO=m
CONFIG_DELL_LAPTOP=m
CONFIG_DELL_SMBIOS=m
CONFIG_DELL_SMBIOS_WMI=m
CONFIG_DELL_SMBIOS_SMM=m
CONFIG_DELL_WMI=m
CONFIG_DELL_PC=y
CONFIG_DELL_SMO8800=m
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=m
CONFIG_CPU_FREQ_GOV_USERSPACE=m
CONFIG_CPU_FREQ_GOV_ONDEMAND=m
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=m
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_X86_ACPI_CPUFREQ=m
CONFIG_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_DELL_SMM=m
CONFIG_I2C=y
CONFIG_I2C_I801=m
CONFIG_BACKLIGHT_CLASS_DEVICE=m

# ZRAM: retain the D630's LZ4 swap path; omit unused compression backends.
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=n
CONFIG_ZRAM_BACKEND_ZSTD=n
CONFIG_ZRAM_BACKEND_DEFLATE=n
CONFIG_ZRAM_BACKEND_842=n
CONFIG_ZRAM_BACKEND_LZO=n
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_WRITEBACK=n

# No DVB, TV tuners, webcam/capture stack or FireWire devices.
CONFIG_MEDIA_SUPPORT=n
CONFIG_DVB_CORE=n
CONFIG_VIDEO_DEV=n
CONFIG_CEC_CORE=n
CONFIG_IEEE1394=n
CONFIG_FIREWIRE=n

# Remove unused peripheral/protocol families; keep ordinary TCP/IP, netfilter,
# Wi-Fi, USB networking, TUN and WireGuard from Gentoo's common configuration.
CONFIG_PARPORT=n
CONFIG_INFINIBAND=n
CONFIG_HAMRADIO=n
CONFIG_CAN=n
CONFIG_ISDN=n
CONFIG_ATM=n
CONFIG_IRDA=n
CONFIG_NFC=n
CONFIG_RDS=n
CONFIG_SCTP=n
CONFIG_DCCP=n
CONFIG_TIPC=n
CONFIG_6LOWPAN=n
CONFIG_WPAN=n
CONFIG_IEEE802154=n
CONFIG_IPX=n
CONFIG_APPLETALK=n
CONFIG_DECNET=n
CONFIG_ECONET=n
CONFIG_X25=n
CONFIG_AX25=n
CONFIG_ROSE=n

# No PCI/ISA wired Ethernet on this build target; USB RNDIS remains enabled.
CONFIG_ETHERNET=n
CONFIG_TIGON3=n

# The D630 is a physical laptop, not a virtual guest. Keep KVM host support
# available on its VT-x CPU, but remove unrelated guest/virtual device drivers.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=n
CONFIG_HYPERVISOR_GUEST=n
CONFIG_HYPERV=n
CONFIG_VIRTIO_PCI=n
CONFIG_VIRTIO_NET=n
CONFIG_VIRTIO_BLK=n
CONFIG_VIRTIO_INPUT=n
CONFIG_VMWARE_BALLOON=n
CONFIG_VMWARE_VMCI=n
CONFIG_VBOXGUEST=n
CONFIG_VBOXSF_FS=n

# No NVMe controller exists in the D630; storage is SATA/ATA.
CONFIG_NVME_CORE=n
CONFIG_BLK_DEV_NVME=n
CONFIG_SPI_INTEL=n
CONFIG_SPI_INTEL_PCI=n
CONFIG_SPI_INTEL_PLATFORM=n

# 20-d630-base.config
# Standard installed Gentoo kernel overlay for the Dell Latitude D630.
#
# Gentoo's version-specific distribution configuration remains the baseline.
# This fragment enables D630 requirements and builds device drivers as modules
# wherever Kconfig permits. Only the ordinary SATA/ext4 root path and essential
# kernel infrastructure are forced built in.
#
# This is not a tiny or live-kernel profile. Do not prune unrelated hardware
# families here; retain Gentoo's normal distribution-kernel coverage.
#
# x86-64 ISA stays generic. Kernel tuning is supplied separately with
# KCFLAGS=-mtune=core2; do not use -march=core2 or -march=native.

# Core kernel facilities and diagnostics.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_PROC_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MICROCODE=y
CONFIG_FW_LOADER=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y

# Root disk: keep the AHCI controller, SCSI disk path and ext4 built in.
# The optical drive's PIIX/ATAPI path can load after the root filesystem.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=m
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=m
CONFIG_SCSI_CDROM=m
CONFIG_EXT4_FS=y

# Other filesystems and layered/removable storage are modules.
CONFIG_BTRFS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_EXFAT_FS=m
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_FUSE_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=m
CONFIG_OVERLAY_FS=m

# GM965 / GMA X3100: DRM core and fbcon infrastructure, i915 as a module.
CONFIG_AGP=y
CONFIG_AGP_INTEL=m
CONFIG_DRM=m
CONFIG_DRM_I915=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_VGA_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Intel PRO/Wireless 3945ABG.
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_IWLEGACY=m
CONFIG_IWL3945=m

# ICH8 USB 2.0, USB storage/HID and Android RNDIS tethering.
CONFIG_USB=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_HID=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_NCM=m

# Input core remains built in; keyboard/serio infrastructure is built in, while
# evdev, PS/2 mouse, HID and virtual input drivers are modules.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=m
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_MOUSE_PS2=m
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_HIDRAW=y
CONFIG_INPUT_JOYSTICK=m
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_UINPUT=m

# IDT/SigmaTel HDA audio and optional Bluetooth USB transport.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m

# ACPI and Dell platform selector remain built in; WMI/SMBIOS and device drivers
# are modules where Kconfig permits. Boolean backend selectors remain enabled.
CONFIG_ACPI=y
CONFIG_ACPI_AC=m
CONFIG_ACPI_BATTERY=m
CONFIG_ACPI_BUTTON=m
CONFIG_ACPI_FAN=m
CONFIG_ACPI_THERMAL=m
CONFIG_ACPI_WMI=m
CONFIG_ACPI_VIDEO=m
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DCDBAS=m
CONFIG_DELL_SMBIOS=m
CONFIG_DELL_SMBIOS_WMI=y
CONFIG_DELL_SMBIOS_SMM=y
CONFIG_DELL_WMI_DESCRIPTOR=m
CONFIG_DELL_LAPTOP=m
CONFIG_DELL_WMI=m
CONFIG_DELL_PC=m
CONFIG_DELL_SMO8800=m

# CPUFreq core and schedutil default; hardware driver and alternative
# governors remain loadable modules.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=m
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=m
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=m
CONFIG_X86_ACPI_CPUFREQ=m

# Thermal, hwmon and I2C frameworks remain built in; concrete sensor/SMBus
# controller drivers are modules.
CONFIG_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_DELL_SMM=m
CONFIG_I2C=y
CONFIG_I2C_I801=m
CONFIG_I2C_SMBUS=m
CONFIG_I2C_ALGOBIT=m
CONFIG_BACKLIGHT_CLASS_DEVICE=m

# The D630 has USB 2.0 EHCI/UHCI only; no xHCI/USB 3 controller.
CONFIG_USB_XHCI_HCD=n

# No NVMe controller exists on this machine; disable host, fabrics and target.
CONFIG_NVME_CORE=n
CONFIG_BLK_DEV_NVME=n
CONFIG_NVME_FABRICS=n
CONFIG_NVME_RDMA=n
CONFIG_NVME_FC=n
CONFIG_NVME_TCP=n
CONFIG_NVME_TARGET=n

# ZRAM: expose every compressor and the optional tracking/recompression/
# writeback features. Runtime selects LZO (40%) or ZSTD level 3 (30%).
CONFIG_DEBUG_FS=y
CONFIG_ZSMALLOC_STAT=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_DEFLATE=y
CONFIG_ZRAM_BACKEND_842=y
CONFIG_ZRAM_DEF_COMP_LZO=y
CONFIG_ZRAM_DEF_COMP_LZORLE=n
CONFIG_ZRAM_DEF_COMP_LZ4=n
CONFIG_ZRAM_DEF_COMP_LZ4HC=n
CONFIG_ZRAM_DEF_COMP_ZSTD=n
CONFIG_ZRAM_DEF_COMP_DEFLATE=n
CONFIG_ZRAM_DEF_COMP_842=n
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_TRACK_ENTRY_ACTIME=y
CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_ZRAM_MULTI_COMP=y

# Gentoo strips modules with USE=strip and compresses them after install with
# USE=modules-compress. Select Zstandard; leave Kbuild's automatic compression
# off so Gentoo can process modules at the correct packaging stage.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_ALL=n

# Minimal X11 desktop for the D630; all atoms must resolve to compatible binpkgs.
# Keep Python 3 in the Openbox runtime.
dev-lang/python
media-libs/mesa
# Direct ALSA fallback alongside PipeWire: library, device profiles, and CLI mixer/test tools.
media-libs/alsa-lib
media-libs/alsa-ucm-conf
media-sound/alsa-utils
media-fonts/terminus-font
sys-auth/elogind
x11-apps/xinit
x11-base/xorg-drivers
x11-base/xorg-server
x11-terms/xterm
x11-wm/openbox
x11-misc/xdg-utils
x11-misc/xclip
x11-misc/xdotool
sys-apps/file
sys-apps/less
x11-apps/xrdb
x11-apps/xmodmap

# Same D630 applet set as d630-static.config, linked against the target libc.
# Do not use this profile for the standalone early initramfs.
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_BUSYBOX=y
# CONFIG_STATIC is not set
CONFIG_FEATURE_INSTALLER=y
CONFIG_INSTALL_APPLET_SYMLINKS=y
CONFIG_PREFIX="/"

CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_PREFER_APPLETS=y

CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CP=y
CONFIG_ECHO=y
CONFIG_FIND=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_MKDIR=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_FEATURE_MOUNT_LOOP=y
CONFIG_SWITCH_ROOT=y
CONFIG_TEST=y
CONFIG_UMOUNT=y
CONFIG_WC=y

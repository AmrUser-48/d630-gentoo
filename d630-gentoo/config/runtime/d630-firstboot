#!/sbin/openrc-run
description="Initialize the Gentoo live user"

depend() {
    before NetworkManager
}
start() {
    groups=
    groupadd -f netdev || return 1
    if ! id -u gentoo >/dev/null 2>&1; then
        useradd -M -U -u 1000 -s /bin/bash gentoo || return 1
    fi
    [ "$(id -u gentoo)" = 1000 ] || return 1
    groups="$(awk -F: '$1 != "gentoo" { print $1 }' /etc/group | paste -sd, -)" || return 1
    [ -n "$groups" ] || return 1
    usermod -aG "$groups" gentoo || return 1
    password_hash="$(openssl passwd -6 gentoo)" || return 1
    usermod -p "$password_hash" gentoo || return 1
    mkdir -p /home/gentoo || return 1
    if [ ! -e /home/gentoo/.bashrc ]; then
        cp -a /etc/skel/. /home/gentoo/ || return 1
    fi
    mkdir -p /home/gentoo/Music || return 1
    chown -R gentoo:gentoo /home/gentoo || return 1
    chmod 0700 /home/gentoo || return 1
    # Copy the optional Wi-Fi profile from the host partition; credentials stay outside the SFS.
    wifi_source=/run/d630/wifi.nmconnection
    wifi_target=/etc/NetworkManager/system-connections/d630-wifi.nmconnection
    if [ -s "$wifi_source" ] && [ -d /etc/NetworkManager ]; then
        mkdir -p /etc/NetworkManager/system-connections || return 1
        cp -f "$wifi_source" "$wifi_target" || return 1
        chown root:root "$wifi_target" || return 1
        chmod 0600 "$wifi_target" || return 1
    fi
}

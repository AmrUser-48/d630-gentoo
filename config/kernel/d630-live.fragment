# Last-wins live-root requirements for the standalone kernel + external initramfs.
# Merge after d630-base.fragment and run make olddefconfig.
# Linux 6.18 x86-64 has no MCORE2 processor-family Kconfig selector (that is 32-bit only).
# Keep the generic x86-64 instruction baseline and tune scheduling with KCFLAGS=-mtune=core2.
# The 500 MB boot partition is not where the conventional Gentoo root is built;
# this config only needs to boot the external /d630-gentoo/squashfs image.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y

# External initramfs loaded by GRUB; don't embed it in the kernel.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=n
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Cross-partition search and root mount.
CONFIG_BLK_DEV_LOOP=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=n
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_64BIT_CLUSTER=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_NLS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_LZ4_DECOMPRESS=y

# Storage controllers used by the D630 and USB rescue media.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_JOYDEV=y

# Intel 965GM/GMA X3100; no AMD/NVIDIA display drivers.
CONFIG_AGP=y
CONFIG_AGP_INTEL=y
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_VGA_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_GMA500=n

# Intel 3945ABG Wi-Fi + Android USB tethering.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_RFKILL=y
CONFIG_IWLEGACY=y
CONFIG_IWL3945=y
CONFIG_IWL4965=n
CONFIG_IWLWIFI=n
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_TUN=n
CONFIG_TIGON3=n

# Bluetooth must remain enabled; a USB Bluetooth adapter is supported.
CONFIG_BLUETOOTH=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y

# D630 SigmaTel HD Audio and power management.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_I915=n
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_VIDEO=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_HZ_250=y
CONFIG_HZ_1000=n

# Built-in zram, LZ4 selected by the base fragment.
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_WRITEBACK=n

# Avoid the capture/TV stack and unused wireless families.
CONFIG_MEDIA_SUPPORT=n
CONFIG_DVB_CORE=n
CONFIG_VIDEO_DEV=n
CONFIG_CEC_CORE=n
CONFIG_B43=n
CONFIG_ATH=n
CONFIG_ATH9K=n
CONFIG_ATH10K=n
CONFIG_ATH11K=n
CONFIG_RTW88=n
CONFIG_RTW89=n
CONFIG_RTL8XXXU=n
CONFIG_MT76=n

# Keep modules enabled for diagnostics, but build/publish no modules at first.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=n
CONFIG_MODVERSIONS=n
CONFIG_MODULE_SIG=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_LOCALVERSION="-d630-gentoo"
CONFIG_LOCALVERSION_AUTO=n

# Main Gentoo root package candidates for d630-gentoo.
# The embedded initramfs has its own list in config/initramfs-package.list.
# This is not a resolved dependency closure. Validate atoms and USE flags
# against the selected Gentoo profile before starting the full build.

# Main Gentoo root: everyday system. Portage stays available for package management;
# compilers, headers, source trees and build caches are not part of the base image.
app-shells/bash
sys-apps/coreutils
sys-apps/findutils
sys-apps/grep
sys-apps/sed
sys-apps/gawk
sys-apps/less
sys-apps/file
app-misc/lf
app-editors/geany
dev-vcs/git
sys-process/htop

sys-apps/dbus
sys-apps/openrc
sys-apps/portage
sys-apps/util-linux
sys-apps/pciutils
sys-apps/usbutils
sys-apps/kmod
sys-fs/squashfs-tools
sys-fs/dosfstools
sys-fs/ntfs3g
sys-fs/btrfs-progs
sys-block/parted
sys-boot/grub
app-editors/nano
app-misc/mc
app-cdr/cdrtools
dev-libs/libisoburn
app-misc/tmux
app-admin/sudo
net-misc/openssh
net-misc/rsync

# Network and radio
net-misc/dhcpcd
net-wireless/iw
net-wireless/wpa_supplicant
net-misc/networkmanager
gnome-extra/nm-applet
net-wireless/bluez

# Xorg desktop
www-client/firefox
lxde-base/pcmanfm
media-sound/alsa-utils
media-video/mpv

x11-base/xorg-server
x11-apps/xinit
x11-apps/xterm
x11-apps/xrandr
x11-apps/xset
x11-apps/xsetroot
x11-apps/xinput
x11-wm/openbox
x11-wm/dwm
x11-wm/herbstluftwm
x11-terms/alacritty
media-fonts/dejavu
media-libs/mesa

# Firmware candidate; confirm exact firmware needs and redistribution terms.
sys-kernel/linux-firmware

# Dell D630: Intel GM965 / GMA X3100 (Gen 4).
# Mesa Crocus is the hardware OpenGL driver. Disable LLVM/llvmpipe and Vulkan/lavapipe.
media-libs/mesa -llvm -vulkan VIDEO_CARDS: -* intel
# Mesa's Intel build helper still uses LLVM/Clang at build time; keep only native x86 and SPIR-V targets.
llvm-core/llvm LLVM_TARGETS: -* X86 SPIRV
llvm-core/clang LLVM_TARGETS: -* X86 SPIRV
# libclc is only needed as Mesa's build helper here; do not build AMD/NVIDIA target libraries.
dev-util/mesa_clc LLVM_SLOT: -* 22
dev-util/mesa_clc VIDEO_CARDS: -*
llvm-runtimes/libclc VIDEO_CARDS: -*

# Xorg: Intel graphics via the built-in modesetting DDX, plus legacy Intel DDX as an alternate.
# On xorg-drivers, "intel" selects xorg-server/modesetting and "i915" selects xf86-video-intel.
x11-base/xorg-drivers VIDEO_CARDS: -* intel i915
x11-base/xorg-drivers INPUT_DEVICES: -* evdev joystick libinput synaptics
x11-base/xorg-server -minimal
x11-drivers/xf86-video-intel dri
sys-auth/pambase elogind
sys-auth/polkit elogind

# Legacy BIOS only for the D630.
sys-boot/grub GRUB_PLATFORMS: pc

# Utilities installed in the temporary SSH builder.
net-misc/openssh pam
app-admin/sudo pam
# Console mouse support for MC and framebuffer terminal.
app-misc/mc gpm
app-i18n/fbterm gpm

# D630 audio: PipeWire + WirePlumber on OpenRC, ALSA compatibility, and Bluetooth audio.
# Use Gentoo's prebuilt PipeWire man pages (-man) instead of building them with Doxygen.
media-video/pipewire bluetooth sound-server pipewire-alsa dbus elogind -man -systemd -system-service -doc -test
media-video/wireplumber elogind -systemd -system-service -doc -test
media-sound/pulseaudio -daemon

# Reduce optional Clang runtime components pulled by the Mesa build helper.
llvm-runtimes/clang-runtime -sanitize -openmp

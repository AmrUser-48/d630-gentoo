# Intel Core 2 Duo T7250 (Merom): never copy CPU flags from the newer CI host.
# Gentoo spelling is cpu_flags_x86_*; only enable instruction sets supported
# by the target. Keep these as package.use flags rather than trusting
# cpuid2cpuflags on a GitHub Actions runner.
*/* cpu_flags_x86: mmx sse sse2 sse3 ssse3

#!/bin/bash
set -Eeuo pipefail

SET_NAME="${1:-none}"
CUSTOM_INPUT="${2:-}"
SET_DIR=/etc/portage/package-sets
declare -a SET_FILES=()
declare -a ATOMS=()
declare -A SEEN=()

die() {
    printf 'gentoo-build-set: ERROR: %s\n' "$*" >&2
    exit 2
}

case "$SET_NAME" in
    none) printf 'No package set selected; nothing to build.\n'; exit 0 ;;
    runner-tools) SET_FILES+=(runner-tools.list) ;;
    cli) SET_FILES+=(cli.list) ;;
    development) SET_FILES+=(development.list) ;;
    desktop) SET_FILES+=(desktop.list) ;;
    multimedia) SET_FILES+=(multimedia.list) ;;
    daily-driver) SET_FILES+=(daily-driver.list) ;;
    custom)
        [[ -n "$CUSTOM_INPUT" ]] || die 'custom package set chosen but CUSTOM_ATOMS is empty.'
        CUSTOM_INPUT="${CUSTOM_INPUT//,/ }"
        read -r -a custom_atoms <<< "$CUSTOM_INPUT"
        for atom in "${custom_atoms[@]}"; do
            [[ "$atom" =~ ^=?[[:alnum:]_+.-]+/[[:alnum:]_+.-]+(:[[:alnum:]_+.-]+)?$ ]] ||
                die "invalid custom atom '$atom'; use simple category/package atoms (no shell syntax or USE-dependency blocks)."
            if [[ -z "${SEEN[$atom]:-}" ]]; then
                ATOMS+=("$atom")
                SEEN[$atom]=1
            fi
        done
        ;;
    *) die "unknown set '$SET_NAME'; choose runner-tools, cli, development, desktop, multimedia, daily-driver, custom, or none." ;;
esac

for file in "${SET_FILES[@]}"; do
    path="$SET_DIR/$file"
    [[ -r "$path" ]] || die "package set file is missing: $path"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        # Portage atoms in the curated lists are one atom per line.
        line="$(printf '%s' "$line" | xargs)"
        [[ -n "$line" ]] || continue
        [[ "$line" =~ ^=?[[:alnum:]_+.-]+/[[:alnum:]_+.-]+(:[[:alnum:]_+.-]+)?$ ]] ||
            die "invalid atom '$line' in $file"
        if [[ -z "${SEEN[$line]:-}" ]]; then
            ATOMS+=("$line")
            SEEN[$line]=1
        fi
    done < "$path"
done

(("${#ATOMS[@]}" > 0)) || die "selected package set contains no atoms."
printf 'Package set: %s\n' "$SET_NAME"
printf 'Target compiler flags: '
grep -E '^(COMMON_FLAGS|CFLAGS|CXXFLAGS)=' /etc/portage/make.conf || true
printf 'Requested atoms (%s):\n' "${#ATOMS[@]}"
printf '  %s\n' "${ATOMS[@]}"
printf '\nStarting Portage; logs are in /var/log/emerge.log and the workflow runner log.\n'

exec emerge --ask=n --verbose --jobs=1 --load-average=4 --buildpkg --with-bdeps=y "${ATOMS[@]}"

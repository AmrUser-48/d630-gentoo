#!/bin/sh
# Minimal embedded early userspace for the D630 loopback live ISO.
# Build BusyBox static with: ash, blkid, cat, find, mount+loop, mkdir,
# sleep, switch_root, tr. Build all boot-path storage/filesystem drivers in.
PATH=/bin:/sbin
export PATH
export LC_ALL=C

cmdline="$(cat /proc/cmdline 2>/dev/null || true)"
debug=0
case " $cmdline " in
    *" d630.debug=1 "*) debug=1; set -x ;;
esac

getarg() {
    key=$1
    for word in $cmdline; do
        case "$word" in
            "$key"=*) printf '%s\n' "${word#*=}"; return 0 ;;
        esac
    done
    return 1
}
log() { echo "[d630-init] $*"; }
fail() {
    log "FATAL: $*"
    log "Emergency shell: inspect /proc/cmdline, /dev, and mount output."
    echo
    mount
    exec /bin/sh
}

mount -t devtmpfs devtmpfs /dev 2>/dev/null || fail "cannot mount devtmpfs"
mount -t proc proc /proc 2>/dev/null || fail "cannot mount proc"
mount -t sysfs sysfs /sys 2>/dev/null || fail "cannot mount sysfs"
mount -t tmpfs -o mode=0755 tmpfs /run 2>/dev/null || fail "cannot mount temporary /run"

mkdir -p /run/d630/bootdev /run/d630/iso /run/d630/lower
mkdir -p /run/d630/persist /run/d630/volatile /mnt/newroot

iso_uuid="$(getarg d630.iso_uuid || true)"
iso_path="$(getarg d630.iso_path || true)"
persistence="$(getarg d630.persistence || echo auto)"
datafile="$(getarg d630.datafile || echo gentoo-data.img)"
rootfs="$(getarg d630.rootfs || echo /LiveOS/rootfs.squashfs)"

[ -n "$iso_uuid" ] || fail "missing d630.iso_uuid; boot through Super Grub2 Disk loopback.cfg"
[ -n "$iso_path" ] || fail "missing d630.iso_path; boot through Super Grub2 Disk loopback.cfg"
case "$iso_path" in
    *' '*) fail "ISO paths containing spaces are not supported yet" ;;
esac
case "$datafile" in
    ""|*/*|*..*) fail "d630.datafile must be a filename beside the ISO" ;;
esac
case "$persistence" in
    auto|volatile) ;;
    *) fail "unsupported d630.persistence value: $persistence" ;;
esac

want_uuid="$(printf '%s' "$iso_uuid" | tr '[:upper:]' '[:lower:]')"
bootdev=''
tries=0
while [ "$tries" -lt 20 ] && [ -z "$bootdev" ]; do
    for dev in $(find /dev -type b 2>/dev/null); do
        got_uuid="$(blkid -s UUID -o value "$dev" 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
        if [ -n "$got_uuid" ] && [ "$got_uuid" = "$want_uuid" ]; then
            bootdev=$dev
            break
        fi
    done
    [ -n "$bootdev" ] && break
    tries=$((tries + 1))
    sleep 1
done
[ -n "$bootdev" ] || fail "could not find backing filesystem UUID $iso_uuid"

host_type="$(blkid -s TYPE -o value "$bootdev" 2>/dev/null || true)"
[ -n "$host_type" ] || fail "could not determine filesystem type on $bootdev"
case "$host_type" in
    ntfs) host_type=ntfs3 ;;
    ext2|ext3|ext4|btrfs|ntfs3|vfat) ;;
    *) fail "unsupported ISO/persistence backing filesystem: $host_type" ;;
esac
log "Mounting ISO backing device $bootdev ($host_type, UUID $iso_uuid)"
mount -t "$host_type" -o rw "$bootdev" /run/d630/bootdev ||
    fail "cannot mount backing filesystem read-write; it stores persistent data"

iso_rel=${iso_path#/}
iso_file="/run/d630/bootdev/$iso_rel"
[ -f "$iso_file" ] || fail "ISO path not found on backing filesystem: $iso_path"
log "Mounting ISO file $iso_path"
mount -t iso9660 -o loop,ro "$iso_file" /run/d630/iso ||
    fail "cannot loop-mount ISO; check kernel ISO9660 and loop support"

rootfs_rel=${rootfs#/}
[ -f "/run/d630/iso/$rootfs_rel" ] || fail "missing SquashFS root in ISO: $rootfs"
log "Mounting read-only SquashFS root: $rootfs"
mount -t squashfs -o loop,ro "/run/d630/iso/$rootfs_rel" /run/d630/lower ||
    fail "cannot mount SquashFS; check CONFIG_SQUASHFS and its compressor"

if [ "$persistence" = auto ]; then
    iso_dir=${iso_rel%/*}
    if [ "$iso_dir" = "$iso_rel" ]; then iso_dir=''; fi
    if [ -n "$iso_dir" ]; then data_rel="$iso_dir/$datafile"; else data_rel="$datafile"; fi
    data_img="/run/d630/bootdev/$data_rel"
    [ -f "$data_img" ] ||
        fail "persistent image not found: $data_rel. Create it with scripts/create-persistence-image.sh"
    log "Mounting persistent ext4 image: $data_rel"
    mount -t ext4 -o loop,rw "$data_img" /run/d630/persist ||
        fail "cannot mount $datafile as ext4; check it with fsck.ext4 on another system"
    mkdir -p /run/d630/persist/upper /run/d630/persist/work ||
        fail "cannot create OverlayFS upper/work directories in $datafile"
    upper=/run/d630/persist/upper
    work=/run/d630/persist/work
else
    log "Using temporary tmpfs overlay; all changes will be lost at reboot"
    mount -t tmpfs -o mode=0755,size=50% tmpfs /run/d630/volatile ||
        fail "cannot allocate volatile OverlayFS storage"
    mkdir -p /run/d630/volatile/upper /run/d630/volatile/work
    upper=/run/d630/volatile/upper
    work=/run/d630/volatile/work
fi

log "Creating merged writable root (persistence=$persistence)"
mount -t overlay overlay -o "lowerdir=/run/d630/lower,upperdir=$upper,workdir=$work" /mnt/newroot ||
    fail "OverlayFS mount failed; check CONFIG_OVERLAY_FS and ext4 upper/work support"
[ -x /mnt/newroot/sbin/init ] || fail "SquashFS root has no executable /sbin/init"

# Keep all backing filesystems alive across switch_root by moving the single
# /run tmpfs, with its child mounts, into the newly mounted root.
mkdir -p /mnt/newroot/dev /mnt/newroot/proc /mnt/newroot/sys /mnt/newroot/run
mount -o move /dev /mnt/newroot/dev || fail "cannot move /dev into new root"
mount -o move /proc /mnt/newroot/proc || fail "cannot move /proc into new root"
mount -o move /sys /mnt/newroot/sys || fail "cannot move /sys into new root"
mount -o move /run /mnt/newroot/run || fail "cannot preserve ISO/persistence mounts under new root /run"

log "Switching to Gentoo userspace"
exec switch_root /mnt/newroot /sbin/init

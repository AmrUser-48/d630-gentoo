#!/bin/sh
# Direct-folder D630 initramfs. GRUB loads /d630-gentoo/kernel and this archive;
# /init scans supported block devices for /d630-gentoo/squashfs.
# Filesystems are tried directly so initramfs does not depend on blkid/udev.
PATH=/bin:/sbin
export PATH
export LC_ALL=C
set -f

cmdline="$(cat /proc/cmdline 2>/dev/null || true)"
case " $cmdline " in
    *" d630.debug=1 "*) set -x ;;
esac

getarg() {
    key=$1
    for word in $cmdline; do
        case "$word" in
            "$key"=*) printf '%s\n' "${word#*=}"; return 0 ;;
        esac
    done
    return 1
}

log() { echo "[d630-init] $*"; }
fail() {
    log "FATAL: $*"
    log "Emergency shell: inspect /proc/cmdline, /dev, and mount output."
    echo
    mount
    exec /bin/sh
}

mount -t devtmpfs devtmpfs /dev 2>/dev/null || fail "cannot mount devtmpfs"
mount -t proc proc /proc 2>/dev/null || fail "cannot mount proc"
mount -t sysfs sysfs /sys 2>/dev/null || fail "cannot mount sysfs"
mount -t tmpfs -o mode=0755 tmpfs /run 2>/dev/null || fail "cannot mount temporary /run"

mkdir -p /run/d630/probe /run/d630/lower /run/d630/volatile /mnt/newroot
squash_arg="$(getarg d630.squashfs || echo /d630-gentoo/squashfs)"
persistence="$(getarg d630.persistence || echo volatile)"

case "$squash_arg" in
    /*) ;;
    *) fail "d630.squashfs must be an absolute path" ;;
esac
case "$squash_arg" in
    *' '*) fail "paths containing spaces are not supported yet" ;;
    *../*|../*|*/..) fail "SquashFS path must not traverse parent directories" ;;
esac
case "$persistence" in
    volatile) ;;
    *) fail "only temporary RAM overlay mode is supported by this three-file build: $persistence" ;;
esac

squash_rel=${squash_arg#/}
found_rootfs=""
found_dev=""
found_type=""

# Do not need filesystem UUIDs or blkid: try the small set of filesystem
# drivers built into this target kernel. Failed mount attempts are expected.
for dev in $(find /dev -type b 2>/dev/null); do
    for host_type in ntfs3 exfat vfat ext4 btrfs; do
        if mount -t "$host_type" -o ro "$dev" /run/d630/probe >/dev/null 2>&1; then
            candidate="/run/d630/probe/$squash_rel"
            if [ -s "$candidate" ]; then
                found_rootfs=$candidate
                found_dev=$dev
                found_type=$host_type
                log "Found $squash_arg on $dev ($host_type)"
                break 2
            fi
            umount /run/d630/probe >/dev/null 2>&1 ||
                fail "cannot unmount $dev after checking for SquashFS"
        fi
    done
done

[ -n "$found_rootfs" ] ||
    fail "cannot find $squash_arg; checked NTFS3, exFAT, VFAT, ext4 and Btrfs partitions"

log "Mounting read-only SquashFS root: $found_rootfs"
mount -t squashfs -o loop,ro "$found_rootfs" /run/d630/lower ||
    fail "cannot mount SquashFS; enable loop and SquashFS Zstandard support in the kernel"

log "Using temporary tmpfs overlay; changes are lost at reboot"
mount -t tmpfs -o mode=0755,size=50% tmpfs /run/d630/volatile ||
    fail "cannot allocate volatile OverlayFS storage"
mkdir -p /run/d630/volatile/upper /run/d630/volatile/work
upper=/run/d630/volatile/upper
work=/run/d630/volatile/work

log "Creating merged writable root"
mount -t overlay overlay -o "lowerdir=/run/d630/lower,upperdir=$upper,workdir=$work" /mnt/newroot ||
    fail "OverlayFS mount failed; check CONFIG_OVERLAY_FS and tmpfs upper/work support"
if [ -d /lib/firmware ]; then
    mkdir -p "$upper/lib/firmware" || fail "cannot create firmware directory in the writable root"
    cp -a /lib/firmware/. "$upper/lib/firmware/" || fail "cannot preserve initramfs firmware across switch_root"
fi

[ -x /mnt/newroot/sbin/init ] || fail "SquashFS root has no executable /sbin/init"

mkdir -p /mnt/newroot/dev /mnt/newroot/proc /mnt/newroot/sys /mnt/newroot/run
mount -o move /dev /mnt/newroot/dev || fail "cannot move /dev into new root"
mount -o move /proc /mnt/newroot/proc || fail "cannot move /proc into new root"
mount -o move /sys /mnt/newroot/sys || fail "cannot move /sys into new root"
mount -o move /run /mnt/newroot/run || fail "cannot preserve root and overlay mounts under new root /run"

log "Switching to Gentoo userspace"
exec switch_root /mnt/newroot /sbin/init

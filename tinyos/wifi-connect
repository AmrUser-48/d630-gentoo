#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "Run wifi-connect as root, for example: doas wifi-connect" >&2
    exit 1
fi

interface=""
config_file=""
diagnose_requested=false

diagnose() {
    echo "Wi-Fi interfaces:"
    iw dev || :
    echo
    echo "Link state:"
    ip link show || :
    if [ -d /sys/class/rfkill ]; then
        echo
        echo "Radio block state (hard=physical switch, soft=software):"
        for rfkill_dir in /sys/class/rfkill/rfkill*; do
            [ -d "$rfkill_dir" ] || continue
            for state in type hard soft state; do
                state_file="$rfkill_dir/$state"
                [ -r "$state_file" ] || continue
                printf '%s: ' "$state_file"
                cat "$state_file"
            done
        done
    fi
    if [ -n "$interface" ] && command -v wpa_cli >/dev/null 2>&1; then
        echo
        echo "WPA supplicant status:"
        wpa_cli -p /run/wpa_supplicant -i "$interface" status || :
    fi
    if [ -r /run/wpa_supplicant.log ]; then
        echo
        echo "WPA supplicant log:"
        sed -n '1,40p' /run/wpa_supplicant.log
    fi
    echo
    echo "Relevant kernel messages:"
    dmesg | grep -Ei 'iwl3945|firmware|rfkill|wlan|wifi' | sed -n '1,30p' || :
}

case ${1:-} in
    --help|-h)
        echo "Usage: doas wifi-connect [INTERFACE]"
        echo "       doas wifi-connect --config WPA_CONFIG [INTERFACE]"
        echo "       doas wifi-connect --diagnose"
        exit 0
        ;;
    --diagnose)
        diagnose_requested=true
        shift
        ;;
    --config)
        [ "$#" -ge 2 ] || {
            echo "--config requires a WPA supplicant configuration file." >&2
            exit 2
        }
        config_file=$2
        shift 2
        ;;
    --*)
        echo "Unknown option: $1" >&2
        echo "Try: doas wifi-connect --help" >&2
        exit 2
        ;;
esac

if [ "$diagnose_requested" = true ]; then
    interface=${1:-}
    diagnose
    exit 0
fi

if [ "$#" -gt 1 ]; then
    echo "Usage: doas wifi-connect [--config WPA_CONFIG] [INTERFACE]" >&2
    exit 2
fi

interface=${1:-}
if [ -z "$interface" ]; then
    interface=$(iw dev | sed -n 's/^[[:space:]]*Interface //p' | head -n 1)
fi
if [ -z "$interface" ]; then
    echo "No Wi-Fi interface found. Check the wireless switch, then inspect the diagnostics below." >&2
    diagnose
    exit 1
fi

fail_connection() {
    echo "Wi-Fi setup failed: $1" >&2
    echo "Diagnostics follow; the passphrase is not shown, but review SSIDs before sharing:" >&2
    diagnose >&2
    exit 1
}

if [ -d /sys/class/rfkill ]; then
    for state_file in /sys/class/rfkill/rfkill*/soft; do
        [ -w "$state_file" ] && printf '0\n' > "$state_file"
    done
    for state_file in /sys/class/rfkill/rfkill*/hard; do
        if [ -r "$state_file" ] && [ "$(cat "$state_file")" = 1 ]; then
            echo "Wi-Fi is hard-blocked. Check the laptop's wireless switch/Fn key." >&2
            diagnose
            exit 1
        fi
    done
fi

if ! ip link set "$interface" up; then
    fail_connection "could not bring $interface up"
fi

umask 077
mkdir -p /run/wpa_supplicant
if [ -n "$config_file" ]; then
    [ -r "$config_file" ] || {
        echo "Cannot read WPA supplicant configuration: $config_file" >&2
        exit 1
    }
    if ! cp "$config_file" /etc/wpa_supplicant.conf ||
        ! chmod 0600 /etc/wpa_supplicant.conf; then
        fail_connection "could not prepare the in-memory WPA configuration"
    fi
else
    echo "Visible Wi-Fi network names (SSIDs):"
    if iw dev "$interface" scan > /run/wifi-scan.txt 2>&1; then
        sed -n 's/^[[:space:]]*SSID: /  /p' /run/wifi-scan.txt
        rm -f /run/wifi-scan.txt
    else
        echo "  Scan failed. Check the wireless switch and run: doas wifi-connect --diagnose"
        sed -n '1,4p' /run/wifi-scan.txt
        rm -f /run/wifi-scan.txt
    fi

    printf 'Wi-Fi network name (SSID): '
    IFS= read -r ssid
    if [ -z "$ssid" ]; then
        echo "SSID cannot be empty." >&2
        exit 1
    fi

    printf 'Wi-Fi WPA/WPA2 password: '
    IFS= read -r -s password
    printf '\n'
    if [ -z "$password" ]; then
        echo "Password cannot be empty." >&2
        exit 1
    fi

    # wpa_passphrase reads from a terminal when its passphrase argument is omitted.
    # Generate the quoted supplicant config directly so a pipe does not cause tcgetattr
    # to fail. Escape characters significant inside quoted wpa_supplicant strings.
    ssid_config=$(printf '%s' "$ssid" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
    password_config=$(printf '%s' "$password" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
    if ! {
        printf 'ctrl_interface=DIR=/run/wpa_supplicant GROUP=0\n'
        printf 'update_config=0\n\nnetwork={\n'
        printf '    ssid="%s"\n' "$ssid_config"
        printf '    psk="%s"\n' "$password_config"
        printf '}\n'
    } > /etc/wpa_supplicant.conf; then
        unset password password_config ssid_config
        echo "Could not create Wi-Fi configuration." >&2
        exit 1
    fi
    chmod 0600 /etc/wpa_supplicant.conf
    unset password password_config ssid_config
fi

wpa_supplicant -B -f /run/wpa_supplicant.log -P /run/wpa_supplicant.pid \
    -i "$interface" -c /etc/wpa_supplicant.conf -C /run/wpa_supplicant ||
    fail_connection "wpa_supplicant could not start"

attempt=0
wpa_state=""
while [ "$attempt" -lt 20 ]; do
    wpa_state=$(wpa_cli -p /run/wpa_supplicant -i "$interface" status 2>/dev/null |
        sed -n 's/^wpa_state=//p')
    [ "$wpa_state" = COMPLETED ] && break
    sleep 1
    attempt=$((attempt + 1))
done
if [ "$wpa_state" != COMPLETED ]; then
    fail_connection "did not authenticate to the access point (wpa_state=${wpa_state:-unknown})"
fi

if ! udhcpc -q -i "$interface" -s /usr/share/udhcpc/default.script; then
    fail_connection "authenticated to Wi-Fi but DHCP did not assign an IP address"
fi
echo "Connected on $interface. Try: curl -fL URL -o /tmp/download"
